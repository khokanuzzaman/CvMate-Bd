# Never put secret keys here: this file is bundled with the app. AI keys live
# on the AI server (repo cvmate-api), never in the client. The only key allowed
# here is RevenueCat's PUBLIC app-specific SDK key (made to ship in apps).
#
# Setup: cp .env.example .env   (.env is gitignored)
#
# Runtime switch, read from this file (flutter_dotenv), debug builds only:
#   true  = canned mock AI answers (offline UI work, costs nothing)
#   false = the real AI server (AI_API_BASE_URL); needs a signed-in user
# Release builds always use the AI server and refuse to start with true.
USE_MOCK_AI=true

# Purchases (RevenueCat), debug builds only:
#   true  = fake purchase service: canned packages, no store, nothing charged,
#           never makes anyone Pro (the server decides Pro)
#   false = RevenueCat with the key below (sandbox on a test device)
# Release builds refuse to start with true.
USE_FAKE_BILLING=true

# RevenueCat public SDK keys (RevenueCat > Project > API keys, the "appl_" /
# "goog_" ones). --dart-define=REVENUECAT_IOS_API_KEY=... wins over this file.
# A release iOS build refuses to start without the iOS key.
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

# Compile-time keys, NOT read from this file. Pass them with --dart-define
# (see lib/core/config/env_config.dart); listed here for reference only:
#   --dart-define=AI_API_BASE_URL=https://api.khokan.me   (default)
#     Release builds REQUIRE an https URL.
