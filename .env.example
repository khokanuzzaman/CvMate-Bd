# Local development only. Do not use client-side OpenAI keys in production.
#
# Setup: cp .env.example .env   (.env is gitignored; never commit real keys)
#
# Runtime keys — read from this file (flutter_dotenv):
USE_MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Compile-time keys — NOT read from this file. Pass them with --dart-define
# (see lib/core/config/env_config.dart); listed here for reference only:
#   --dart-define=OPENAI_PROXY_URL=<https://your-ai-proxy>   (default: empty)
#   --dart-define=USE_FIREBASE_AI=true|false                 (default: false)
#     Release builds REQUIRE true: they refuse to start on the mock AI.
#   --dart-define=FIREBASE_FUNCTIONS_REGION=us-central1      (default: us-central1)
