# Local development only. Never put API keys here: this file is bundled with
# the app. AI keys live on the AI server (repo cvmate-api), never in the client.
#
# Setup: cp .env.example .env   (.env is gitignored)
#
# Runtime switch, read from this file (flutter_dotenv), debug builds only:
#   true  = canned mock AI answers (offline UI work, costs nothing)
#   false = the real AI server (AI_API_BASE_URL); needs a signed-in user
# Release builds always use the AI server and refuse to start with true.
USE_MOCK_AI=true

# Compile-time keys, NOT read from this file. Pass them with --dart-define
# (see lib/core/config/env_config.dart); listed here for reference only:
#   --dart-define=AI_API_BASE_URL=https://api.khokan.me   (default)
#     Release builds REQUIRE an https URL.
