rules_version = '2';

// CareerMate BD — Firestore security rules.
//
// All user-owned data lives under users/{uid}/**. A signed-in user (including
// anonymous/guest users, who still have a stable request.auth.uid) may read and
// write ONLY their own subtree. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
